// Icons and version information of the exe.
#include <winver.h>
#include "Version.h"
#include "resource.h"

IDI_APP ICON "Assets/AppIcon.ico"
IDI_COMIC_FILE ICON "Assets/ComicFile.ico"


VS_VERSION_INFO VERSIONINFO
 FILEVERSION CDX_VERSION_COMMAS
 PRODUCTVERSION CDX_VERSION_COMMAS
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "ComicsDisplayExp"
            VALUE "FileDescription", "ComicsDisplayExp comic book viewer"
            VALUE "FileVersion", CDX_VERSION_STRING
            VALUE "InternalName", "ComicsDisplayExp"
            VALUE "OriginalFilename", "ComicsDisplayExp.exe"
            VALUE "ProductName", "ComicsDisplayExp"
            VALUE "ProductVersion", CDX_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
